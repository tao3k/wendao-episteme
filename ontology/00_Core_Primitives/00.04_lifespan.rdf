<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:wendao="https://wendao.ai/ontology/core#">

  <owl:Ontology rdf:about="https://wendao.ai/ontology/core/lifespan">
    <rdfs:label>Wendao L0 Lifespan and Mutability Primitives</rdfs:label>
    <rdfs:comment>Defines temporal validity and supersession primitives for evolving truths.</rdfs:comment>
    <owl:imports rdf:resource="https://wendao.ai/ontology/core/entity"/>
    <owl:versionInfo>0.1.0</owl:versionInfo>
  </owl:Ontology>

  <owl:Class rdf:about="https://wendao.ai/ontology/core#Lifespan">
    <rdfs:label>Lifespan</rdfs:label>
    <rdfs:comment>A temporal validity interval for a semantic entity or assertion.</rdfs:comment>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="https://wendao.ai/ontology/core#validFrom">
    <rdfs:label>valid from</rdfs:label>
    <rdfs:comment>Timestamp at which an entity or assertion becomes valid.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://wendao.ai/ontology/core#validTo">
    <rdfs:label>valid to</rdfs:label>
    <rdfs:comment>Timestamp at which an entity or assertion stops being valid. Absence means currently active.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="https://wendao.ai/ontology/core#hasLifespan">
    <rdfs:label>has lifespan</rdfs:label>
    <rdfs:comment>Links an entity to its temporal validity interval.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wendao.ai/ontology/core#BaseEntity"/>
    <rdfs:range rdf:resource="https://wendao.ai/ontology/core#Lifespan"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="https://wendao.ai/ontology/core#supersedes">
    <rdfs:label>supersedes</rdfs:label>
    <rdfs:comment>Links a newer entity or assertion to the older entity or assertion it replaces.</rdfs:comment>
    <rdfs:domain rdf:resource="https://wendao.ai/ontology/core#BaseEntity"/>
    <rdfs:range rdf:resource="https://wendao.ai/ontology/core#BaseEntity"/>
  </owl:ObjectProperty>
</rdf:RDF>
